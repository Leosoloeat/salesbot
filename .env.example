PORT=3000

# LINE OA — SalesBot
LINE_CHANNEL_SECRET=your_salesbot_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_salesbot_long_lived_token

# Gemini API
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Escalation — Leo's LINE user ID (get from webhook logs)
OWNER_USER_ID=your_line_user_id

# Facebook Messenger (optional — bot answers FB DMs with the same AI brain)
# Leave blank to keep Messenger off (LINE keeps working). Set all 3 to enable.
# Webhook callback URL on Meta = https://<your-railway-domain>/fb/webhook
FB_PAGE_ACCESS_TOKEN=your_page_access_token
FB_VERIFY_TOKEN=any_random_string_must_match_meta_webhook
FB_APP_SECRET=meta_app_secret_for_signature_check
GRAPH_API_VERSION=v25.0
